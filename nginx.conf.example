# Nginx 설정 예시 (기존 nginx.conf에 추가)
# /etc/nginx/sites-available/portfolio 파일 생성 후 심볼릭 링크

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;  # 실제 도메인으로 변경

    # 이미지 업로드 경로 직접 서빙 (Next.js의 public/uploads)
    location /uploads/ {
        alias /var/www/portfolio/public/uploads/;  # 서버 실제 경로로 변경
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Next.js 앱으로 리버스 프록시
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 60s;
    }
}

# HTTPS (Certbot 사용 시 자동으로 추가됨)
# sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com
